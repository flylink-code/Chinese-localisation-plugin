{
  "name": "chinese-localiser",
  "version": "0.1.3",
  "private": true,
  "description": "多工具中文本地化管理软件：检测安装、查看汉化状态、应用与卸载汉化",
  "desktopName": "chinese-localiser.desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flylink-code/Chinese-localisation-plugin.git"
  },
  "homepage": "https://github.com/flylink-code/Chinese-localisation-plugin#readme",
  "author": {
    "name": "flylink-code",
    "email": "flylink-code@users.noreply.github.com"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "sync:plugin": "node scripts/sync-bundled-plugin.cjs",
    "build": "npm run sync:plugin && vite build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test": "node --test electron/test/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.localiser.chinese",
    "productName": "汉化管家",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "flylink-code",
      "repo": "Chinese-localisation-plugin"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!electron/test/**"
    ],
    "extraResources": [
      {
        "from": "resources/plugins",
        "to": "plugins"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "ChineseLocaliser-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "汉化管家",
      "installerLanguages": [
        "zh_CN"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "chinese-localiser",
      "syncDesktopName": true,
      "maintainer": "flylink-code <flylink-code@users.noreply.github.com>",
      "artifactName": "ChineseLocaliser-${version}-linux-${arch}.${ext}"
    }
  }
}
